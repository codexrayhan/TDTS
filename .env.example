# Static builds default to demo/mock mode when VITE_API_URL is empty.
# Vite dev defaults to /api and mounts the local middleware automatically.
VITE_API_URL=/api

# Prisma SQLite database. Relative to prisma/schema.prisma for Prisma CLI.
DATABASE_URL="file:./dev.db"

# Development fallback is built in; replace in production.
JWT_SECRET="tdts-development-secret-change-me"

# Optional. When empty, /api/ai/recommend uses the deterministic demo profiles.
OPENAI_API_KEY=""

# Standalone API server port.
PORT=8787
